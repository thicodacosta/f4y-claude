# Copie para .env.local. Em dev, os valores vêm de `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor — nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Aplicação: papel journeylab_app (sujeito a RLS).
DATABASE_URL=
# Migrações e rls.sql: conexão administrativa (postgres).
DATABASE_MIGRATE_URL=
# Senha do papel journeylab_app (aplicada por `npm run db:rls`).
JOURNEYLAB_APP_DB_PASSWORD=
# URL pública do site (links de confirmação de e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# Kiwify — somente servidor. Obtidos no painel da Kiwify (Apps › API).
KIWIFY_ACCOUNT_ID=
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
# Token cadastrado no webhook (Apps › Webhooks). Gere um valor aleatório longo.
KIWIFY_WEBHOOK_TOKEN=

# Rotina diária /api/cron/manutencao (a Vercel envia como Bearer).
CRON_SECRET=

# Compras pelo site: segredo compartilhado para assinar o webhook (HMAC-SHA256).
SITE_WEBHOOK_SECRET=
# "true" aplica compras automaticamente (token conferido + correspondência única).
# Padrão: desligado — cada evento aguarda revisão do superadmin.
INTEGRACAO_ATIVACAO_AUTOMATICA=false

# E-mail transacional (lembretes). Em dev: Mailpit do Supabase local (SMTP 54525, sem senha).
SMTP_HOST=127.0.0.1
SMTP_PORT=54525
SMTP_USUARIO=
SMTP_SENHA=
SMTP_SEGURO=false
EMAIL_REMETENTE="JourneyLab <nao-responda@journeylab.local>"

# Pulse: segredo dos links pessoais de resposta (HMAC, 32+ caracteres). Trocar invalida links já enviados.
PULSE_LINK_SECRET=
# Opcional: segredo próprio dos convites do Diagnóstico NR-1 (sem ele, usa PULSE_LINK_SECRET com contexto separado).
NR1_LINK_SECRET=
# Opcional: segredo próprio dos links da entrevista de desligamento (sem ele, usa PULSE_LINK_SECRET com contexto separado).
OFFBOARDING_LINK_SECRET=
# IA (insights do Pulse, sugestões do NR-1, análise executiva do People Analytics). Sem chave, o recurso aparece como indisponível.
ANTHROPIC_API_KEY=
# Nome do modelo definido pela sua conta (obrigatório para habilitar a IA; nenhum modelo é fixo no código).
IA_MODELO=
