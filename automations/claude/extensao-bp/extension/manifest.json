{
  "manifest_version": 3,
  "name": "Candydate · BP",
  "version": "1.2.0",
  "description": "Gestão de pessoas: Onboarding, Produtividade, Cultura, Turnover, Pulso, Offboarding, Gestão preditiva e Chat com IA.",
  "icons": {
    "16": "dist/icons/icon-16.png",
    "48": "dist/icons/icon-48.png",
    "128": "dist/icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir Candydate · BP",
    "default_icon": {
      "16": "dist/icons/icon-16.png",
      "48": "dist/icons/icon-48.png",
      "128": "dist/icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://*.supabase.co/*",
    "http://127.0.0.1/*"
  ]
}
