# Copie para .env.local. O `npm run build` embute estes valores no pacote.
# As chaves de IA e o projeto Supabase são os mesmos da ToolsKit
# (../extensao-entrevistas/.env.local): sem este arquivo, o build usa os de lá.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Endereço onde a página pública das pesquisas (public-dist/index.html) está
# publicada. Os links do Pulso e da entrevista de desligamento apontam para ele.
# Pode ser alterado depois em Configurações.
BP_PUBLIC_URL=
