{
  "manifest_version": 3,
  "name": "JourneyLab · ToolsKit",
  "version": "1.23.0",
  "description": "Entrevistas, currículos, comparativo, pesquisa salarial, turnover, prompts, Shortlist no LinkedIn e Chat com IA para RH.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir JourneyLab",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://www.linkedin.com/*",
    "https://*.supabase.co/*"
  ]
}
