{
  "manifest_version": 3,
  "name": "Find4You · Registro de Entrevistas",
  "version": "1.0.0",
  "description": "Estrutura o registro de entrevistas transcritas como apoio à documentação do recrutador. Não avalia, não pontua, não decide.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir registro de entrevista",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.anthropic.com/*"]
}
