{
  "manifest_version": 3,
  "name": "Find4You · Ferramentas de RH",
  "version": "1.4.0",
  "description": "Entrevistas gravadas e transcritas, currículos padronizados com a sua marca, comparativo de candidatos, pesquisa salarial, calculadora de turnover e prompts para RH.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir registro de entrevista",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.groq.com/*"
  ]
}
