{
  "manifest_version": 3,
  "name": "Find4You · Registro de Entrevistas",
  "version": "1.1.0",
  "description": "Grava e transcreve a entrevista no Meet, Teams ou Zoom e estrutura o registro para o dossiê. Não avalia, não pontua, não decide.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir registro de entrevista",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.groq.com/*"
  ]
}
