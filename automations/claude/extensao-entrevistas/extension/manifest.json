{
  "manifest_version": 3,
  "name": "Find4You · Ferramentas de RH",
  "version": "1.8.0",
  "description": "Entrevistas gravadas e transcritas, currículos padronizados, comparativo, pesquisa salarial, turnover, prompts e Shortlist no LinkedIn.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir registro de entrevista",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.groq.com/*",
    "https://www.linkedin.com/*"
  ]
}
