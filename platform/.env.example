# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (supabase.com → Project Settings → API).

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" — segura para expor no browser (RLS protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Connection string do Postgres para o Prisma (Project Settings → Database →
# Connection string → "Transaction" pooler para DATABASE_URL, "Session"/direct
# para DIRECT_URL, usado nas migrations)
DATABASE_URL=
DIRECT_URL=

# Nunca commitar a service_role key de um projeto real. Necessária a partir da
# Fase 7 (Portais externos) para lib/supabase/admin.ts convidar cliente/
# candidato via auth.admin.inviteUserByEmail — fica só em variável de ambiente
# do servidor de deploy, nunca em .env versionado nem prefixada com
# NEXT_PUBLIC_. Em dev local, use o valor fixo impresso por `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Fase 8 (IA) — chave da conta Anthropic (console.anthropic.com), usada por
# modules/ia/client.ts para gerar JD, resumir currículo, score de candidato e
# matching. Sem valor demo local possível (é uma credencial de conta real) —
# peça ao dono do projeto.
ANTHROPIC_API_KEY=

# Fase 9 (Integrações) — cada usuário conecta a PRÓPRIA conta em
# /configuracoes/integracoes (ver modelo IntegracaoUsuario), então estas
# chaves aqui são só do App OAuth em si (Google Cloud Console / LinkedIn
# Developer Portal), não credenciais de uma pessoa específica.
# Redirect URI a registrar no Google Cloud Console:
#   http://localhost:3000/api/integracoes/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI a registrar no LinkedIn Developer Portal:
#   http://localhost:3000/api/integracoes/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# WhatsApp Business (Meta) não usa estas variáveis — cada usuário cola o
# próprio Phone Number ID + access token (gerados no Meta Business Manager)
# direto na tela de Integrações; ver modules/integracoes/whatsapp.ts.
